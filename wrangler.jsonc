{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bridgetranslate",
  "main": "src/live-index.js",
  "compatibility_date": "2026-07-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/*"
    ]
  },
  "observability": {
    "enabled": false
  }
}
